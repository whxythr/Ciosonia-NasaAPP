    \u0443\u0433\u043B\u0435\u043A\u0438\u0441\u043B\u043E\u0433\u043E \u0433\u0430\u0437\u0430.
    \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u043F\u043E\u043B\u0443\u0448\u0430\u0440\u0438\u0435
    \u043F\u043E\u043A\u0440\u044B\u0442\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0439
    \u043F\u044B\u043B\u044C\u044E \u2014 \u0437\u043E\u043B\u0438\u043D\u043E\u043C
    (\u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u044B, \u043A\u0430\u043A \u043D\u0430
    \u0425\u0430\u0440\u043E\u043D\u0435), \u044E\u0436\u043D\u043E\u0435 \u2014
