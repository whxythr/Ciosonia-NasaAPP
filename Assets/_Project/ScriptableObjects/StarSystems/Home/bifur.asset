    \u2014 \u0431\u043E\u043B\u0435\u0435 \u0433\u043B\u0430\u0434\u043A\u0438\u0439
    \u043F\u043E\u044F\u0441. \u041F\u0440\u0438\u043B\u0438\u0432\u043D\u043E \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D,
    \u0431\u0435\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B, \u0432
    \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u043F\u043E\u044F\u0441\u0430\u0445.
