  description: "\u0411\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043A \u0415\u0440\u0435\u043C\u0443\u0441\u0443
    \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A,
    \u0432\u043D\u0443\u0442\u0440\u0438 \u0435\u0433\u043E \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043F\u043E\u044F\u0441\u043E\u0432. \u0411\u043B\u0435\u0434\u043D\u043E-\u043F\u0435\u0440\u0441\u0438\u043A\u043E\u0432\u044B\u0439:
    \u0431\u0443\u0433\u0440\u0438\u0441\u0442\u044B\u0435 \u043D\u0430\u0433\u043E\u0440\u044C\u044F,
    \u0438\u0437\u0440\u044B\u0442\u044B\u0435 \u043C\u0435\u043B\u043A\u0438\u043C\u0438
    \u043A\u0440\u0430\u0442\u0435\u0440\u0430\u043C\u0438, \u0438 \u0433\u043B\u0430\u0434\u043A\u0438\u0435
    \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u0440\u0430\u0432\u043D\u0438\u043D\u044B.
    \u041F\u0440\u0438\u043B\u0438\u0432\u043D\u043E \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D,
    \u0431\u0435\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B. \u2212135
    \xB0C, g = 0.258 \u043C/\u0441\xB2, \u0441\u0443\u0442\u043A\u0438 = \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    = 0.474 \u0437\u0435\u043C\u043D\u044B\u0445."
