  description: "\u0421\u0435\u0434\u044C\u043C\u043E\u0439 \u0438 \u0441\u0430\u043C\u044B\u0439
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A
    \u0415\u0440\u0435\u043C\u0443\u0441\u0430 (0.24 M\u2295, g = 5.16 \u043C/\u0441\xB2)
    \u2014 \u0430\u043D\u0430\u043B\u043E\u0433 \u0422\u0438\u0442\u0430\u043D\u0430.
    \u041F\u0440\u0438 \u2212179 \xB0C \xAB\u043E\u043A\u0435\u0430\u043D\xBB \u043D\u0435
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432\u043E\u0434\u043E\u0439:
    \u044D\u0442\u043E \u043C\u043E\u0440\u044F \u0436\u0438\u0434\u043A\u043E\u0433\u043E
    \u043C\u0435\u0442\u0430\u043D\u0430 \u0438 \u044D\u0442\u0430\u043D\u0430 \u043F\u043E\u0434
    \u0430\u0437\u043E\u0442\u043D\u043E\u0439 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043E\u0439
    (\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u0437\u0430\u0434\u0430\u043D\u043E
    \u2014 \u0434\u043E\u043F\u0443\u0449\u0435\u043D\u0438\u0435 1.5 \u0431\u0430\u0440);
    \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0439 \u0446\u0432\u0435\u0442
    \u2014 \u043C\u0435\u0442\u0430\u043D \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442
    \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0441\u0432\u0435\u0442. \u0421\u0443\u0448\u0430
    \u2014 \u043B\u0451\u0434 \u0438 \u043F\u043E\u0440\u043E\u0434\u0430 \u043F\u043E\u0434
    \u0440\u044B\u0436\u0435\u0432\u0430\u0442\u044B\u043C\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u043E\u0441\u0430\u0434\u043A\u0430\u043C\u0438, \u043E\u0431\u043B\u0430\u043A\u0430
    \u2014 \u043C\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u0435. \u041F\u0440\u0438\u043B\u0438\u0432\u043D\u043E
    \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D, \u0441\u0443\u0442\u043A\u0438
    = \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 = 9.42 \u0437\u0435\u043C\u043D\u044B\u0445."
