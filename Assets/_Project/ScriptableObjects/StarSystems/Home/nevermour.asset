    \u0432 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043F\u043E\u044F\u0441\u0430\u0445. \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0435
    \u0441\u0436\u0430\u0442\u0438\u0435 0.131 % (\u043D\u0435 \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F).
