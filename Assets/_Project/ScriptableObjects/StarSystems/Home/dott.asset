  description: "\u041C\u0435\u043D\u044C\u0448\u0438\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
    \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B
    \u041C\u043E\u0447\u0430-\u041C\u043E\u0447\u0430 + \u0414\u043E\u0442. \u0421\u0435\u0440\u044B\u0439,
    \u0431\u0435\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B, \u0432
    \u043A\u0440\u0430\u0442\u0435\u0440\u0430\u0445 \u0438 \u0441\u0432\u0435\u0442\u043B\u043E\u043C
    \u0438\u043D\u0435\u0435. \u041F\u0440\u0438\u043B\u0438\u0432\u043D\u043E \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D:
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0432\u0451\u0440\u043D\u0443\u0442
    \u043A \u041C\u043E\u0447\u0435-\u041C\u043E\u0447\u0435 \u043E\u0434\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u0441\u0443\u0442\u043A\u0438
    = \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 = 5.39 \u0437\u0435\u043C\u043D\u044B\u0445,
