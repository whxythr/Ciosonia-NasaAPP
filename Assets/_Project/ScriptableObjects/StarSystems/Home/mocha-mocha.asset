  description: "\u0421\u0430\u043C\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u044F\u044F
    \u043F\u043B\u0430\u043D\u0435\u0442\u0430, \u0431\u043E\u043B\u044C\u0448\u0438\u0439
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u041C\u043E\u0447\u0430-\u041C\u043E\u0447\u0430
    + \u0414\u043E\u0442. \u041A\u043E\u0444\u0435\u0439\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F,
    \u0431\u0435\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B, \u0432
    \u043A\u0440\u0430\u0442\u0435\u0440\u0430\u0445 \u0438 \u043F\u044F\u0442\u043D\u0430\u0445
    \u0438\u043D\u0435\u044F. \u041E\u0431\u0449\u0438\u0439 \u0446\u0435\u043D\u0442\u0440
    \u043C\u0430\u0441\u0441 \u043F\u0430\u0440\u044B \u043B\u0435\u0436\u0438\u0442
    \u0432\u043D\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u044B, \u0432 14 550
    \u043A\u043C \u043E\u0442 \u0435\u0451 \u0446\u0435\u043D\u0442\u0440\u0430;
    \u043F\u0430\u0440\u0430 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0437\u0432\u0435\u0437\u0434\u044B \u0437\u0430
