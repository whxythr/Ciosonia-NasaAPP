  description: "\u0412\u043E\u0441\u044C\u043C\u043E\u0439, \u0441\u0430\u043C\u044B\u0439
    \u0434\u0430\u043B\u0451\u043A\u0438\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0415\u0440\u0435\u043C\u0443\u0441\u0430.
    \u0416\u0451\u043B\u0442\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0441
    \u043B\u043E\u0441\u043E\u0441\u0435\u0432\u044B\u043C\u0438 \u043E\u0442\u0442\u0435\u043D\u043A\u0430\u043C\u0438,
    \u0443\u0441\u044B\u043F\u0430\u043D \u0441\u0432\u0435\u0442\u043B\u044B\u043C\u0438
    \u043A\u0440\u0443\u0433\u043B\u044B\u043C\u0438 \u043F\u044F\u0442\u043D\u0430\u043C\u0438.
    \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043D\u0435
    \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u043B\u0438\u0432\u043E\u043C:
    \u0441\u0443\u0442\u043A\u0438 0.481 \u0437\u0435\u043C\u043D\u044B\u0445, \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    12.4 \u0441\u0443\u0442\u043E\u043A; \u0441\u0430\u043C\u0430\u044F \u043D\u0430\u043A\u043B\u043E\u043D\u043D\u0430\u044F
    (8.14\xB0) \u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F \u043E\u0440\u0431\u0438\u0442\u0430.
    \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0435 \u0441\u0436\u0430\u0442\u0438\u0435
    0.685 % (\u043D\u0435 \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F).
    \u2212189 \xB0C \u2014 \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435 \u043F\u0440\u0435\u0434\u0435\u043B\u0430
    \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0430, g = 0.798 \u043C/\u0441\xB2.
    \u041C\u0430\u0441\u0441\u0430 \u0432 \u0434\u0430\u043D\u043D\u044B\u0445 \u2014
    \u043E\u043F\u0435\u0447\u0430\u0442\u043A\u0430; \u043F\u0440\u0438\u043D\u044F\u0442\u0430
    2.75\xB710\xB2\xB9 \u043A\u0433 (\u0438\u0437 g \u0438 \u03C1)."
