  description: "\u0412\u0442\u043E\u0440\u043E\u0439 \u043F\u043E \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B. \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 (\u221242.6
    \xB0C) \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u043C\u0430 \u0434\u043B\u044F
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0441\u043B\u0435\u0433\u043A\u0430 \u0432\u0438\u0434\u0438\u043C\u043E\u0439
    \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0435 \u0438\u0437 \u0430\u0440\u0433\u043E\u043D\u0430
    \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E
    \u0433\u0435\u043B\u0438\u044F \u0438 \u043D\u0435\u043E\u043D\u0430. \u0411\u043E\u043B\u044C\u0448\u0438\u0445
    \u043A\u0440\u0430\u0442\u0435\u0440\u043E\u0432 \u043D\u0435\u0442, \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0433\u043B\u0430\u0434\u043A\u0430\u044F, \u0435\u0441\u0442\u044C \u043E\u0434\u0438\u043D
    \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043A\u0430\u043D\u044C\u043E\u043D.
    \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. g = 0.31 \u043C/\u0441\xB2,
