  description: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A
    \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B.
    \u041A\u0440\u0430\u0441\u043D\u043E\u0432\u0430\u0442\u043E-\u0440\u043E\u0437\u043E\u0432\u044B\u0439
    \u0438\u0437-\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u0438\u0439
    \u0436\u0435\u043B\u0435\u0437\u0430 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.
    \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043B\u0441\u044F, \u043A\u0430\u043A
    \u041B\u0443\u043D\u0430: \u043F\u0440\u0438 \u0433\u0438\u043F\u043E\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u0434\u0432\u0443\u0445
    \u043F\u043B\u0430\u043D\u0435\u0442. \u041F\u0440\u0438\u043B\u0438\u0432\u043D\u043E
    \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D, \u0431\u0435\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B
    (\u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043F\u043B\u0430\u043D\u0435\u0442\u0435,
    \u043C\u0430\u043B\u0430\u044F \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F).
    \u0412\u0441\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0432 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0445 \u043A\u0440\u0430\u0442\u0435\u0440\u0430\u0445,
    \u0442\u0451\u043C\u043D\u043E-\u0441\u0435\u0440\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438
    \u2014 \xAB\u043C\u043E\u0440\u044F\xBB. \u2212111 \u2026 \u2212156 \xB0C, g
    = 0.53 \u043C/\u0441\xB2, \u0441\u0443\u0442\u043A\u0438 = \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    = 1.7 \u0437\u0435\u043C\u043D\u044B\u0445"
  hazards:
    radiationLevel: 1
